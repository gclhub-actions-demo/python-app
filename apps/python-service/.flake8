[flake8]
# Maximum line length
max-line-length = 120

# Exclude directories
exclude = 
    .git,
    __pycache__,
    .venv,
    venv,
    build,
    dist,
    *.egg-info

# Ignore specific errors
ignore = 
    # E501: Line too long (handled by max-line-length)
    # W503: Line break before binary operator (conflicts with PEP8)
    W503

# Enable statistics
statistics = true

# Show source
show-source = true

# Count errors
count = true
